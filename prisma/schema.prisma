// Nur Quiz — Islamic-themed quiz platform
// Prisma + MongoDB

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum QuizDifficulty {
  EASY
  MEDIUM
  HARD
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  phone         String?
  role          Role      @default(USER)
  streak        Int       @default(0)
  bestScore     Int       @default(0)
  lastQuizAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  quizzes  Quiz[]    @relation("QuizAuthor")
  attempts Attempt[]
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Quiz {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  slug        String         @unique
  title       String
  description String?
  coverEmoji  String         @default("📖")
  episode     String?
  difficulty  QuizDifficulty @default(MEDIUM)
  durationSec Int            @default(0)
  published   Boolean        @default(false)
  authorId    String?        @db.ObjectId
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  author    User?      @relation("QuizAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  questions Question[]
  attempts  Attempt[]
}

model Question {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  quizId      String   @db.ObjectId
  order       Int      @default(0)
  text        String
  options     String[]
  correctIdx  Int
  explanation String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers Answer[]
}

model Attempt {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  quizId      String        @db.ObjectId
  userId      String?       @db.ObjectId
  guestName   String?
  score       Int           @default(0)
  total       Int           @default(0)
  durationSec Int           @default(0)
  status      AttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  finishedAt  DateTime?

  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  answers Answer[]
}

model Answer {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  attemptId  String  @db.ObjectId
  questionId String  @db.ObjectId
  selected   Int
  correct    Boolean

  attempt  Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}
